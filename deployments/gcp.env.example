# Copy this file to gcp.env (in this same directory) and fill in real
# values. gcp.env is gitignored as an exact filename (see ../.gitignore) —
# this example file is not, so it's safe to commit as a template.
#
# deploy-gcp.sh sources gcp.env automatically; never edit deploy-gcp.sh
# itself to add real values, or they'll end up committed the moment
# someone `git add`s it.
#
# Quote NEON_DATABASE_URL, as shown below — this file gets `source`d as an
# actual shell script, not parsed as inert data, so an unquoted `&` in the
# connection string (Neon appends "&channel_binding=require" to its own
# copy-pasteable URLs) is read as a shell background-job operator, not a
# literal character — the value silently never gets set. Quoting avoids
# this for any special character, not just `&`.

PROJECT_ID=your-gcp-project-id
REGION=us-central1
NEON_DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT.neon.tech/DBNAME?sslmode=require"
