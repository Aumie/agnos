# Copy to .env in this same directory to override the local dev defaults
# baked into docker-compose.yml. .env is gitignored (see ../.gitignore's
# ".env" pattern) — this example file is not, so it's a safe template.
#
# Neither variable needs to be set for `docker compose up` to work — both
# have working defaults in docker-compose.yml (POSTGRES_PASSWORD/JWT_SECRET
# default to placeholder values), since this only ever protects a Postgres
# instance local to your own machine's Docker network, never reachable from
# the internet. Override these if you want something less predictable than
# the checked-in defaults, not because the defaults are unsafe as shipped.
#
# This is unrelated to deploy-gcp.sh's gcp.env, which holds real secrets
# for a real, internet-reachable deployment — see docs/deploy-gcp.md.

POSTGRES_PASSWORD=hospital_middleware
JWT_SECRET=change-me-in-real-deployments
